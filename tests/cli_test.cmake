function(expect_success pattern)
    execute_process(COMMAND "${HEAT}" ${ARGN}
                    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR NOT output MATCHES "${pattern}" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Expected success for ${ARGN}: exit=${status}, output=${output}, error=${error}")
    endif()
    if(output MATCHES "case=V ")
        if(NOT output MATCHES " err_inf=[0-9.e+-]+ err_l2=[0-9.e+-]+")
            message(FATAL_ERROR "Case V is missing error norms: ${output}")
        endif()
    elseif(output MATCHES "err_(inf|l2)=")
        message(FATAL_ERROR "Unexpected verification errors: ${output}")
    endif()
endfunction()

function(expect_failure pattern)
    execute_process(COMMAND "${HEAT}" ${ARGN}
                    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "1" OR NOT error MATCHES "${pattern}" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Expected failure for ${ARGN}: exit=${status}, output=${output}, error=${error}")
    endif()
endfunction()

expect_success("^Usage: heat" --help)
expect_success("decomp=serial P=1 case=1 N=4 steps=3 r=0[.]125 dt=0[.]0078125 T=0[.]0234375 t_total=[^ ]+ t_comp=[^ ]+ t_comm=0"
               --case 1 --N 4 --r 0.125 --steps 3 --decomp serial)
expect_success("case=2 N=4 steps=2 r=0[.]1875 dt=0[.]01171875 T=0[.]0234375 "
               --case 2 --N 4 --r 0.25 --T 0.0234375)
expect_success("case=V N=4 steps=1 r=0[.]25 dt=0[.]015625 T=0[.]015625 "
               --case V --N 4 --r 0.25 --T 0.015625)
expect_success("steps=0 .* T=0 " --case V --N 4 --r 0.25 --T 0)

file(GLOB files_before "${CMAKE_CURRENT_BINARY_DIR}/*")
expect_success("case=V" --case V --N 4 --r 0.25 --steps 0)
file(GLOB files_after "${CMAKE_CURRENT_BINARY_DIR}/*")
if(NOT files_before STREQUAL files_after)
    message(FATAL_ERROR "A run without --out created a file")
endif()

set(zero "0000000000000000")
set(one "000000000000f03f")
set(quarter "000000000000d03f")
set(eighth "000000000000c03f")
string(REPEAT "${one}" 5 hot_row)
string(REPEAT "${zero}" 5 cold_row)
set(field "${CMAKE_CURRENT_BINARY_DIR}/cli-field.bin")

expect_success("case=1" --case 1 --N 4 --r 0.125 --steps 1 --out "${field}")
file(SIZE "${field}" bytes)
file(READ "${field}" first HEX)
set(near_edge "${one}${quarter}${eighth}${quarter}${one}")
set(middle "${one}${eighth}${zero}${eighth}${one}")
if(NOT bytes EQUAL 200 OR NOT first STREQUAL "${hot_row}${near_edge}${middle}${near_edge}${hot_row}")
    message(FATAL_ERROR "Unexpected size or little-endian bytes for the Case 1 field")
endif()
expect_success("case=1" --case 1 --N 4 --r 0.125 --steps 1 --out "${field}")
file(READ "${field}" repeated HEX)
if(NOT first STREQUAL repeated)
    message(FATAL_ERROR "Repeated Case 1 run produced different bytes")
endif()

expect_success("case=2" --case 2 --N 4 --r 0.125 --steps 0 --out "${field}")
file(READ "${field}" case2 HEX)
if(NOT case2 STREQUAL "${hot_row}${cold_row}${cold_row}${cold_row}${hot_row}")
    message(FATAL_ERROR "Case 2 must store hot horizontal rows and corners")
endif()

expect_success("case=V" --case V --N 4 --r 0.125 --steps 0 --out "${field}")
foreach(offset 0 8 16 24 32 40 72 80 112 120 152 160 168 176 184 192)
    file(READ "${field}" boundary OFFSET ${offset} LIMIT 8 HEX)
    if(NOT boundary STREQUAL zero)
        message(FATAL_ERROR "Case V boundary at byte ${offset} must be exactly zero")
    endif()
endforeach()
expect_failure("Cannot open output file" --case 1 --N 4 --r 0.125 --steps 0 --out "${field}/child.bin")

expect_failure("--r must be finite" --case 1 --N 4 --r 0.251 --steps 1)
expect_failure("--r must be finite" --case 1 --N 4 --r nan --steps 1)
foreach(invalid_r 0 -0.2 inf -inf 0.2625)
    expect_failure("--r must be finite" --case 1 --N 4 --r ${invalid_r} --steps 1)
endforeach()
expect_failure("--N must be greater" --case 1 --N 1 --r 0.25 --steps 1)
expect_failure("--N is too large" --case 1 --N 2147483647 --r 0.25 --steps 0)
expect_failure("--N requires a valid" --case 1 --N 2147483648 --r 0.25 --steps 1)
expect_failure("Unknown option --invalid" --invalid 4)
expect_failure("exactly one" --case 1 --N 4 --r 0.25 --steps 1 --T 1)
expect_failure("exactly one" --case 1 --N 4 --r 0.25)
expect_failure("strips decomposition is not implemented" --decomp strips --case 1 --N 4 --r 0.25 --steps 1)
expect_failure("blocks decomposition is not implemented" --decomp blocks --case 1 --N 4 --r 0.25 --steps 1)
expect_failure("--T requires more time steps" --case 1 --N 4 --r 0.25 --T 1e20)
expect_failure("--T must be finite" --case 1 --N 4 --r 0.25 --T inf)
expect_failure("--steps must be non-negative" --case 1 --N 4 --r 0.25 --steps -1)
expect_failure("Missing required option --case" --N 4 --r 0.25 --steps 1)
expect_failure("--case must be" --case 3 --N 4 --r 0.25 --steps 1)
